#!/usr/bin/env bash
# niri 电源管理: 带确认的 关机/重启/挂起
# 用法: niri-power <poweroff|reboot|suspend>
set -euo pipefail

ACTION="${1:-}"

case "$ACTION" in
  poweroff) TITLE="关机"; CMD="sudo systemctl poweroff";;
  reboot)   TITLE="重启"; CMD="sudo systemctl reboot";;
  suspend)  TITLE="挂起"; CMD="systemctl suspend";;
  *) echo "用法: niri-power <poweroff|reboot|suspend>"; exit 1;;
esac

# 弹 zenity 确认框 (Linux 桌面风格)
if zenity --question \
    --title="$TITLE" \
    --text="确定要$TITLE吗？" \
    --ok-label="确定" \
    --cancel-label="取消"; then
    # 后台执行, 给系统一点反馈时间
    nohup bash -c "$CMD" >/dev/null 2>&1 &
fi
