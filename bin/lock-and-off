#!/bin/bash
# lock-and-off —— 锁屏并立即熄屏（niri 的 Ctrl+Alt+L）
#
# 用户需求（2026-09-24）：按下锁屏键 → 屏幕立刻黑掉；按任意键 → 亮屏显示锁屏界面 → 输密码。
#
# 为什么不直接在 niri 里写两行 action：
#   `spawn "hyprlock"` 是异步的，紧跟 `power-off-monitors` 会熄得太快，
#   锁屏界面还没接管就断了显示 ⇒ 按键唤醒的一瞬间可能看到**未锁的桌面**（安全窗口期）。
#   这里等 hyprlock 真正接管 session lock 之后再熄屏。
#
# 唤醒方式：niri 的 power-off-monitors 文档写明「收到键盘/鼠标输入会自动重新打开显示器」，
#   所以按任意键即可亮屏，不需要额外操作。
#
# 手工测试：bash ~/.local/bin/lock-and-off
# 卡住时强制解锁：pkill -USR1 hyprlock

export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

hyprlock &
LOCK_PID=$!

# 等 hyprlock 接管 session lock（实测从启动到 "locking session" 在 1 秒内完成，
# 0.8s 是留了余量的值；太快会踩上面说的安全窗口期，太慢会显得"按了没反应"）。
sleep 0.8

# 只有 hyprlock 还活着才熄屏 —— 若配置写错导致它秒退，就不熄屏，
# 保持屏幕可见，免得用户对着一块黑屏不知道发生了什么。
if kill -0 "$LOCK_PID" 2>/dev/null; then
    niri msg action power-off-monitors >/dev/null 2>&1
fi

# 一直挂着，直到用户输密码解锁（hyprlock 退出）
wait "$LOCK_PID"
