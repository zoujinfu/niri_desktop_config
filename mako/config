# Notification daemon settings (mako)
font=JetBrainsMono Nerd Font 10
default-timeout=5000
ignore-timeout=1
border-size=2
border-color=#3fbf8f
background-color=#12161ccc
text-color=#e6edf3
padding=12
margin=8
width=320
anchor=top-right
layer=overlay
icons=1
history=1
max-history=200
max-visible=5
group-by=app-name
actions=true
on-button-left=dismiss
on-button-right=dismiss

[urgency=low]
default-timeout=5000

[urgency=normal]
default-timeout=5000

[urgency=critical]
default-timeout=10000
