[Unit]
Description=Watchdog: make sure the Wallpaper Engine wallpaper is still running

[Service]
Type=oneshot
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/sky/.local/bin/wallpaper-rotate.sh ensure
TimeoutStartSec=30
# 只终止主进程; 脚本用 setsid 拉起并脱离的壁纸进程保留(同 wallpaper-rotate.service)
KillMode=process
