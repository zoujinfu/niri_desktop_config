// ============================================================
// Niri 配置 —— Arch Linux (niri 26.04)
// 路径: ~/.config/niri/config.kdl
// 修改后执行 `niri validate` 校验；保存后会自动热加载。
// ============================================================

// ============================================================
// 输入设备
// ============================================================

input {
    keyboard {
        xkb {
            // 留空 = 使用系统键盘布局（当前为 English (US)）。
        }
    }

    touchpad {
        tap
        natural-scroll
        scroll-factor 0.8
    }

    mouse {}

    // 在「上一个工作区」再按一次时自动弹回
    workspace-auto-back-and-forth
}


// ============================================================
// 开机自启动
// ============================================================

// 桌面外壳：状态栏 / 通知 / 启动器 / 锁屏 / 剪贴板 / OSD / polkit
spawn-at-startup "noctalia" "--daemon"

// 动态壁纸（30 分钟自动轮换由 systemd user timer 负责）
spawn-at-startup "/home/sky/.local/bin/wallpaper-rotate.sh"

// Vicinae 启动器服务（Alt+Space 唤起）
spawn-at-startup "vicinae" "server"


// ============================================================
// 通用选项
// ============================================================

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// 窗口边框由合成器绘制
prefer-no-csd

cursor {
    hide-when-typing
    hide-after-inactive-ms 1500
}

// 快捷键面板只显示已绑定的按键
hotkey-overlay {
    hide-not-bound
}


// ============================================================
// 布局
// ============================================================

layout {
    gaps 12

    // 必须透明，否则会盖住 backdrop 层的动态壁纸
    background-color "transparent"

    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 0.5
    }

    // Catppuccin Mocha 配色
    focus-ring {
        width 3
        active-color "#89b4fa"
        inactive-color "#45475a"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    tab-indicator {
        width 4
        length total-proportion=1.0
        position "top"
        gap 4
        gaps-between-tabs 2
        active-color "#89b4fa"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    // Super+Ctrl+E 切换窗口高度所需
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    insert-hint {
        color "#89b4fa"
    }
}


// ============================================================
// 总览
// ============================================================

overview {
    zoom 0.5
    backdrop-color "#1e1e2e"
    workspace-shadow {
        off
    }
}


// ============================================================
// 手势
// ============================================================

gestures {
    dnd-edge-view-scroll {
        trigger-width 30
        delay-ms 100
        max-speed 1500
    }
}


// ============================================================
// 窗口规则
// ============================================================

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// app-id 必须与窗口实际上报的大小写完全一致
window-rule {
    match app-id="Translate.py"
    open-floating true
}

window-rule {
    match app-id="mark-shot"
    open-floating true
}

// VSCode 毛玻璃：半透明 + 背景模糊（niri 26.04 起支持 background-effect）
// 前提：VSCode 内部背景必须设为半透明，见 settings.json 里的 workbench.colorCustomizations
// 注意：blur 默认走 xray 模式，模糊的是壁纸而非下层窗口，这是 niri 的优化行为
// app-id 两种写法各建一条规则：同一条规则内的多个 match 是「且」关系，不能并列写。
window-rule {
    match app-id="^code$"

    opacity 0.85
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="^com\\.microsoft\\.VSCode$"

    opacity 0.9
    background-effect {
        blur true
    }
}


// ============================================================
// 快捷键
// ============================================================

binds {

    // hotkey-overlay-title=null：按键照常生效，只是不显示在快捷键面板。

    // ================= 帮助 =================
    // Super+? 在 niri 中写作 Super+Shift+Slash
    Super+Shift+Slash hotkey-overlay-title="显示快捷键帮助 (Super+?)" { show-hotkey-overlay; }

    // ================= 应用启动 =================
    Super+T hotkey-overlay-title="打开终端" { spawn "/usr/bin/kitty"; }
    Super+E hotkey-overlay-title="文件管理器" { spawn "nautilus"; }
    Super+Delete hotkey-overlay-title="回收站" { spawn "sh" "-c" "gio open trash:///"; }
    Alt+Space hotkey-overlay-title="应用启动器 (Vicinae)" { spawn "vicinae" "toggle"; }
    Super+P hotkey-overlay-title="番茄钟 开始/暂停" { spawn "noctalia" "msg" "plugin" "thepunkoff/pomodoro:pomodoro" "all" "toggle"; }
    Super+Ctrl+P hotkey-overlay-title="番茄钟 面板" { spawn "noctalia" "msg" "panel-toggle" "thepunkoff/pomodoro:panel"; }
    Super+Alt+P hotkey-overlay-title="番茄钟 重置全部" { spawn "noctalia" "msg" "plugin" "thepunkoff/pomodoro:pomodoro" "all" "reset-all"; }

    // ================= 基础窗口管理 =================
    Super+W hotkey-overlay-title="关闭窗口" { close-window; }
    Super+M hotkey-overlay-title="最大化列" { maximize-column; }
    Super+Shift+M hotkey-overlay-title="全屏窗口" { fullscreen-window; }
    Super+Ctrl+M hotkey-overlay-title="最大化到边缘" { maximize-window-to-edges; }
    Super+Ctrl+F hotkey-overlay-title="扩展列到可用宽度" { expand-column-to-available-width; }
    Super+C hotkey-overlay-title="居中当前列" { center-column; }
    Super+Ctrl+C hotkey-overlay-title="居中所有可见列" { center-visible-columns; }
    Super+Shift+F hotkey-overlay-title="切换浮动/平铺" { toggle-window-floating; }
    Super+Shift+T hotkey-overlay-title="切换列标签页显示" { toggle-column-tabbed-display; }

    // ================= 焦点移动（面板隐藏） =================
    // Super+J / Super+K 用于工作区上下切换，列内上下焦点请用 Super+Up / Super+Down。
    Super+Left hotkey-overlay-title=null { focus-column-left; }
    Super+Right hotkey-overlay-title=null { focus-column-right; }
    Super+Up hotkey-overlay-title=null { focus-window-up; }
    Super+Down hotkey-overlay-title=null { focus-window-down; }
    Super+H hotkey-overlay-title=null { focus-column-left; }
    Super+L hotkey-overlay-title=null { focus-column-right; }

    // ================= 移动窗口/列（面板隐藏） =================
    Super+Ctrl+Left hotkey-overlay-title=null { move-column-left; }
    Super+Ctrl+Right hotkey-overlay-title=null { move-column-right; }
    Super+Ctrl+Up hotkey-overlay-title=null { move-window-up; }
    Super+Ctrl+Down hotkey-overlay-title=null { move-window-down; }
    Super+Ctrl+H hotkey-overlay-title=null { move-column-left; }
    Super+Ctrl+L hotkey-overlay-title=null { move-column-right; }
    Super+Ctrl+K hotkey-overlay-title=null { move-window-up; }
    Super+Ctrl+J hotkey-overlay-title=null { move-window-down; }

    // ================= 循环/跨边界导航（面板隐藏） =================
    Super+Alt+Left hotkey-overlay-title=null { focus-column-left-or-last; }
    Super+Alt+Right hotkey-overlay-title=null { focus-column-right-or-first; }
    Super+Alt+Up hotkey-overlay-title=null { focus-window-or-workspace-up; }
    Super+Alt+Down hotkey-overlay-title=null { focus-window-or-workspace-down; }
    Super+Alt+H hotkey-overlay-title=null { focus-column-left-or-last; }
    Super+Alt+L hotkey-overlay-title=null { focus-column-right-or-first; }
    Super+Alt+K hotkey-overlay-title=null { focus-window-or-workspace-up; }
    Super+Alt+J hotkey-overlay-title=null { focus-window-or-workspace-down; }

    // ================= 首/末列（面板隐藏） =================
    Super+Home hotkey-overlay-title=null { focus-column-first; }
    Super+End hotkey-overlay-title=null { focus-column-last; }
    Super+Ctrl+Home hotkey-overlay-title=null { move-column-to-first; }
    Super+Ctrl+End hotkey-overlay-title=null { move-column-to-last; }

    // ================= 多显示器焦点（面板隐藏） =================
    Super+Shift+Left hotkey-overlay-title=null { focus-monitor-left; }
    Super+Shift+Right hotkey-overlay-title=null { focus-monitor-right; }
    Super+Shift+Up hotkey-overlay-title=null { focus-monitor-up; }
    Super+Shift+Down hotkey-overlay-title=null { focus-monitor-down; }
    Super+Shift+H hotkey-overlay-title=null { focus-monitor-left; }
    Super+Shift+L hotkey-overlay-title=null { focus-monitor-right; }
    Super+Shift+K hotkey-overlay-title=null { focus-monitor-up; }
    Super+Shift+J hotkey-overlay-title=null { focus-monitor-down; }

    // ================= 列移到显示器（面板隐藏） =================
    Super+Ctrl+Shift+Left hotkey-overlay-title=null { move-column-to-monitor-left; }
    Super+Ctrl+Shift+Right hotkey-overlay-title=null { move-column-to-monitor-right; }
    Super+Ctrl+Shift+Up hotkey-overlay-title=null { move-column-to-monitor-up; }
    Super+Ctrl+Shift+Down hotkey-overlay-title=null { move-column-to-monitor-down; }
    Super+Ctrl+Shift+H hotkey-overlay-title=null { move-column-to-monitor-left; }
    Super+Ctrl+Shift+L hotkey-overlay-title=null { move-column-to-monitor-right; }
    Super+Ctrl+Shift+K hotkey-overlay-title=null { move-column-to-monitor-up; }
    Super+Ctrl+Shift+J hotkey-overlay-title=null { move-column-to-monitor-down; }

    // ================= 工作区移到显示器（面板隐藏） =================
    Super+Alt+Shift+Left hotkey-overlay-title=null { move-workspace-to-monitor-left; }
    Super+Alt+Shift+Right hotkey-overlay-title=null { move-workspace-to-monitor-right; }
    Super+Alt+Shift+Up hotkey-overlay-title=null { move-workspace-to-monitor-up; }
    Super+Alt+Shift+Down hotkey-overlay-title=null { move-workspace-to-monitor-down; }
    Super+Alt+Shift+H hotkey-overlay-title=null { move-workspace-to-monitor-left; }
    Super+Alt+Shift+L hotkey-overlay-title=null { move-workspace-to-monitor-right; }
    Super+Alt+Shift+K hotkey-overlay-title=null { move-workspace-to-monitor-up; }
    Super+Alt+Shift+J hotkey-overlay-title=null { move-workspace-to-monitor-down; }

    // ================= 工作区（面板仅显示总览） =================
    Super+1 hotkey-overlay-title=null { focus-workspace 1; }
    Super+2 hotkey-overlay-title=null { focus-workspace 2; }
    Super+3 hotkey-overlay-title=null { focus-workspace 3; }
    Super+4 hotkey-overlay-title=null { focus-workspace 4; }
    Super+5 hotkey-overlay-title=null { focus-workspace 5; }
    Super+6 hotkey-overlay-title=null { focus-workspace 6; }
    Super+7 hotkey-overlay-title=null { focus-workspace 7; }
    Super+8 hotkey-overlay-title=null { focus-workspace 8; }
    Super+9 hotkey-overlay-title=null { focus-workspace 9; }

    Super+Ctrl+1 hotkey-overlay-title=null { move-column-to-workspace 1; }
    Super+Ctrl+2 hotkey-overlay-title=null { move-column-to-workspace 2; }
    Super+Ctrl+3 hotkey-overlay-title=null { move-column-to-workspace 3; }
    Super+Ctrl+4 hotkey-overlay-title=null { move-column-to-workspace 4; }
    Super+Ctrl+5 hotkey-overlay-title=null { move-column-to-workspace 5; }
    Super+Ctrl+6 hotkey-overlay-title=null { move-column-to-workspace 6; }
    Super+Ctrl+7 hotkey-overlay-title=null { move-column-to-workspace 7; }
    Super+Ctrl+8 hotkey-overlay-title=null { move-column-to-workspace 8; }
    Super+Ctrl+9 hotkey-overlay-title=null { move-column-to-workspace 9; }

    Super+Page_Down hotkey-overlay-title=null { focus-workspace-down; }
    Super+Page_Up hotkey-overlay-title=null { focus-workspace-up; }
    Super+J hotkey-overlay-title=null { focus-workspace-down; }
    Super+K hotkey-overlay-title=null { focus-workspace-up; }
    Super+Tab hotkey-overlay-title="总览(Overview)" { toggle-overview; }
    Super+Backspace hotkey-overlay-title=null { focus-workspace-previous; }
    Super+Ctrl+Backspace hotkey-overlay-title=null { focus-window-previous; }

    Super+Ctrl+Page_Down hotkey-overlay-title=null { move-column-to-workspace-down; }
    Super+Ctrl+Page_Up hotkey-overlay-title=null { move-column-to-workspace-up; }
    Super+Ctrl+U hotkey-overlay-title=null { move-column-to-workspace-down; }
    Super+Ctrl+I hotkey-overlay-title=null { move-column-to-workspace-up; }

    Super+Shift+Page_Down hotkey-overlay-title=null { move-workspace-down; }
    Super+Shift+Page_Up hotkey-overlay-title=null { move-workspace-up; }

    // ================= 窗口分组/交换（面板隐藏） =================
    Super+BracketLeft hotkey-overlay-title=null { consume-or-expel-window-left; }
    Super+BracketRight hotkey-overlay-title=null { consume-or-expel-window-right; }
    Super+Comma hotkey-overlay-title=null { consume-window-into-column; }
    Super+Period hotkey-overlay-title=null { expel-window-from-column; }
    Super+Ctrl+Comma hotkey-overlay-title=null { swap-window-left; }
    Super+Ctrl+Period hotkey-overlay-title=null { swap-window-right; }

    // ================= 列/窗口尺寸（面板仅显示核心项） =================
    Super+R hotkey-overlay-title="切换列宽" { switch-preset-column-width; }
    Super+Shift+R hotkey-overlay-title=null { switch-preset-column-width-back; }
    Super+Ctrl+E hotkey-overlay-title="切换窗口高度" { switch-preset-window-height; }
    Super+Ctrl+Shift+E hotkey-overlay-title=null { switch-preset-window-height-back; }
    Super+Ctrl+R hotkey-overlay-title="重置窗口高度" { reset-window-height; }
    Super+Minus hotkey-overlay-title=null { set-column-width "-10%"; }
    Super+Equal hotkey-overlay-title=null { set-column-width "+10%"; }
    Super+Shift+Minus hotkey-overlay-title=null { set-window-height "-10%"; }
    Super+Shift+Equal hotkey-overlay-title=null { set-window-height "+10%"; }

    // ================= 鼠标滚轮（面板隐藏） =================
    Super+WheelScrollDown cooldown-ms=150 hotkey-overlay-title=null { focus-workspace-down; }
    Super+WheelScrollUp cooldown-ms=150 hotkey-overlay-title=null { focus-workspace-up; }
    Super+Ctrl+WheelScrollDown cooldown-ms=150 hotkey-overlay-title=null { move-column-to-workspace-down; }
    Super+Ctrl+WheelScrollUp cooldown-ms=150 hotkey-overlay-title=null { move-column-to-workspace-up; }
    Super+WheelScrollRight hotkey-overlay-title=null { focus-column-right; }
    Super+WheelScrollLeft hotkey-overlay-title=null { focus-column-left; }
    Super+Ctrl+WheelScrollRight hotkey-overlay-title=null { move-column-right; }
    Super+Ctrl+WheelScrollLeft hotkey-overlay-title=null { move-column-left; }

    // ================= 截图 =================
    Print hotkey-overlay-title="截图标注 (mark-shot)" { spawn "mark-shot"; }

    // ================= 键盘控制鼠标 (wl-kbptr) =================
    // Super+G：截屏识别屏幕上可点击的元素 → 打字选中 → 左键点击。
    //   分区标签是字母；Backspace 退回上一步；Esc 取消。
    // Super+Shift+G：全屏网格 + 二分逼近，只移动指针不点击（纯挪鼠标用这个）。
    //   注意 bisect/split 模式下 g / h / b 会分别触发左/右/中键，属内置行为。
    // Super+Alt+G：同上识别流程，但改为右键点击（开右键菜单）。
    // 提示：niri 开了 cursor hide-when-typing，wl-kbptr 结束后指针可能短暂隐藏，动一下鼠标即恢复。
    Super+G hotkey-overlay-title="键盘点击屏幕元素 (wl-kbptr)" { spawn "wl-kbptr" "-o" "modes=floating,click" "-o" "mode_floating.source=detect"; }
    Super+Shift+G hotkey-overlay-title="键盘移动鼠标指针" { spawn "wl-kbptr" "-o" "modes=tile,bisect" "-o" "mode_click.button=none"; }
    Super+Alt+G hotkey-overlay-title="键盘右键点击元素" { spawn "wl-kbptr" "-o" "modes=floating,click" "-o" "mode_floating.source=detect" "-o" "mode_click.button=right"; }

    // ================= 音量 =================
    // allow-when-locked=true：锁屏状态下也能调节
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title=null { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title=null { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title=null { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    Super+F3 hotkey-overlay-title="音量增加" { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+; notify-send '音量' \"$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%.0f%%\", $2*100}')\""; }
    Super+F2 hotkey-overlay-title="音量减少" { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; notify-send '音量' \"$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%.0f%%\", $2*100}')\""; }

    // ================= 亮度 =================
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title=null { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title=null { spawn "brightnessctl" "set" "5%-"; }
    Super+F6 hotkey-overlay-title="亮度增加" { spawn-sh "sudo -n brightnessctl -d nvidia_0 set +5%; notify-send '亮度' \"$(brightnessctl -d nvidia_0 get)%\""; }
    Super+F5 hotkey-overlay-title="亮度减少" { spawn-sh "sudo -n brightnessctl -d nvidia_0 set 5%-; notify-send '亮度' \"$(brightnessctl -d nvidia_0 get)%\""; }

    // ================= 媒体控制 =================
    // playerctl 未安装，媒体控制走 Noctalia
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title=null { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title=null { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title=null { spawn "noctalia" "msg" "media" "previous"; }

    // 外接键盘没有媒体键，用 Z/X 代替
    Super+Z hotkey-overlay-title="上一曲" { spawn "noctalia" "msg" "media" "previous"; }
    Super+X hotkey-overlay-title="下一曲" { spawn "noctalia" "msg" "media" "next"; }
    Super+Shift+X hotkey-overlay-title="播放/暂停" { spawn "noctalia" "msg" "media" "toggle"; }

    // ================= 屏幕电源 =================
    // 立刻熄屏，按任意键或移动鼠标恢复
    Super+Shift+O hotkey-overlay-title="立刻熄屏" { power-off-monitors; }
    // 临时禁用/恢复所有快捷键（游戏、远程桌面时使用）
    Super+Escape allow-inhibiting=false hotkey-overlay-title="暂停快捷键" { toggle-keyboard-shortcuts-inhibit; }

    // ================= 壁纸 =================
    Super+F12 hotkey-overlay-title="下一张壁纸" { spawn "/home/sky/.local/bin/wallpaper-rotate.sh" "next"; }
    Super+F11 hotkey-overlay-title="上一张壁纸" { spawn "/home/sky/.local/bin/wallpaper-rotate.sh" "prev"; }
    // 壁纸默认只在充电时显示
    Super+F10 hotkey-overlay-title="壁纸: 电池上也显示" { spawn "/home/sky/.local/bin/wallpaper-rotate.sh" "ignore"; }
    Super+Shift+F10 hotkey-overlay-title="壁纸: 只充电时显示" { spawn "/home/sky/.local/bin/wallpaper-rotate.sh" "respect"; }

    // ================= 剪贴板/翻译 =================
    Super+V hotkey-overlay-title="剪贴板历史 (Noctalia)" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Super+D hotkey-overlay-title="翻译选中文本" { spawn "python3" "/home/sky/bin/translate.py"; }

    // ================= 锁屏/电源/退出 =================
    // 锁屏并熄屏（Noctalia 负责锁屏，如需要可取消注释）
    // Ctrl+Alt+L hotkey-overlay-title="锁屏并熄屏" { spawn-sh "noctalia msg session lock; sleep 1; noctalia msg dpms-off"; }
    Ctrl+Alt+Delete hotkey-overlay-title="退出 niri" { quit; }
    Super+Shift+P hotkey-overlay-title="关机" { spawn "noctalia" "msg" "session" "shutdown"; }
    Super+Shift+Q hotkey-overlay-title="重启" { spawn "noctalia" "msg" "session" "reboot"; }
    Super+Shift+S hotkey-overlay-title="挂起" { spawn "noctalia" "msg" "session" "suspend"; }
}


// ============================================================
// 层规则
// ============================================================

// 把动态壁纸放进 backdrop 层，避免总览里被复制到每个工作区。
// 必须配合 layout 中的 background-color "transparent" 才能看见壁纸。
layer-rule {
    match namespace="^linux-wallpaperengine$"
    place-within-backdrop true
}


// ============================================================
// 调试
// ============================================================

// 睡眠/唤醒后出现黑屏时，可启用：
// debug {
//     force-disable-connectors-on-resume
// }


// ============================================================
// 输出设备
// ============================================================

output "eDP-1" {
    // 刷新率必须与 EDID 完全一致（144.003），否则会回退到 60Hz
    mode "1920x1080@144.003"
}
